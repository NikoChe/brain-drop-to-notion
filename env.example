# ===============================
# 🤖 Telegram Bot Settings / Настройки Telegram-бота
# ===============================

# Telegram bot token from @BotFather / Токен бота от BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram user IDs allowed to use the bot
# Разрешённые Telegram ID (через запятую). Получить через @userinfobot
ALLOWED_USERS=123456789

# Trigger phrase to send message to Notion / Фраза-триггер
TRIGGER_PHRASE=#записать

# Docker container name / Имя Docker-контейнера
CONTAINER_NAME=braindroptonotion

# Port to expose (for testing or healthcheck) / Порт
PORT=9889

# ===============================
# 📒 Notion Settings / Настройки Notion
# ===============================

# Integration token from https://www.notion.so/my-integrations
# Токен интеграции с Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID (32 characters) / ID базы
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===============================
# 🌍 Optional / Опционально
# ===============================

# Default language ('ru' or 'en') / Язык по умолчанию
DEFAULT_LANG=ru
